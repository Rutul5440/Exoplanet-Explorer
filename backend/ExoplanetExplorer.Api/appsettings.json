{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ExoplanetDb": "Server=localhost;Database=ExoplanetExplorer;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Sync": {
    "BaseUrl": "https://exoplanetarchive.ipac.caltech.edu/TAP/sync",
    "DailyRunHourUtc": 2,
    "SyncTimeoutSeconds": 90,
    "EnableStartupSeed": true,
    "EnableBackgroundTimer": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  }
}
